APP_NAME=Paper Trading Lab v0.29.4.1
DB_PATH=data/paper_trading.db

ASSET_MODE=crypto
MARKET_PROVIDER=alpaca
ALPACA_API_KEY=YOUR_PAPER_KEY
ALPACA_SECRET_KEY=YOUR_PAPER_SECRET

CRYPTO_LOCATION=us
CRYPTO_SYMBOLS=BTC/USD,ETH/USD,SOL/USD,XRP/USD,DOGE/USD,ADA/USD,AVAX/USD,LINK/USD,LTC/USD,BCH/USD,AAVE/USD,ARB/USD,BAT/USD,BONK/USD,CRV/USD,DOT/USD,FIL/USD,GRT/USD,LDO/USD,ONDO/USD,PAXG/USD,PEPE/USD,POL/USD,RENDER/USD,SHIB/USD,SUSHI/USD,UNI/USD,WIF/USD,XTZ/USD,YFI/USD
CRYPTO_UNIVERSE_AUTO=true
CRYPTO_UNIVERSE_REFRESH_MINUTES=15
CRYPTO_PRESCAN_REFRESH_MINUTES=5
CRYPTO_PRESCAN_LIMIT=50
CRYPTO_BLACKLIST=
CRYPTO_LATEST_BATCH_SIZE=50
CRYPTO_HISTORY_BATCH_SIZE=10

MAX_SYMBOL_WEIGHT=0.10
MAX_POSITIONS=8
CRYPTO_MAX_POSITIONS=8
MAX_DRAWDOWN_STOP=0.15

MAX_GROSS_EXPOSURE_RATIO=0.80
CRYPTO_MAX_GROSS_EXPOSURE_RATIO=0.80
RESERVE_CASH_RATIO=0.20
LEVERAGE_ENABLED=false
SHORTING_ENABLED=false

POLL_SECONDS=60
HISTORICAL_BARS=360
CHART_BARS=120

PAPER_BROKER_ENABLED=true

NIGHTLY_HOUR_JST=6
NIGHTLY_MINUTE_JST=30

OLLAMA_ENABLED=false
