# v0.29.4 full-Universe 1-minute recorder
CRYPTO_RECORD_ALL_UNIVERSE=true
CRYPTO_RECORDER_BOOTSTRAP_PER_CYCLE=10
CRYPTO_RECORDER_MIN_HISTORY_BARS=360