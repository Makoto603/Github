OLLAMA_MODEL=qwen3:8b

AI_CONFERENCE_ROLES=4

# v0.29.4 Alpaca REST protection
ALPACA_SNAPSHOT_TTL_SECONDS=15
ALPACA_STALE_IF_ERROR_SECONDS=180
ALPACA_RATE_LIMIT_BACKOFF_SECONDS=10
